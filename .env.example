# Copy to .env.local (or run `npm run setup`, which writes it for you).

# Postgres connection string. Neon (https://neon.tech) is recommended; any plain PostgreSQL also works
# (self-hosted, Docker, RDS...), e.g. postgresql://USER:PASSWORD@localhost:5432/sserp
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional driver override: "neon" (Neon serverless driver) or "pg" (node-postgres, plain Postgres).
# Leave unset to auto-detect: hosts ending in .neon.tech (pooler hosts included) use neon, everything else pg.
# Set DB_DRIVER=neon for a Neon database reached through another hostname (a custom proxy or domain).
DB_DRIVER=

# Random secret used to sign login sessions. At least 32 characters.
# Generate one:  openssl rand -base64 48
AUTH_SECRET=

# Web installer (/install) protection. REQUIRED on Vercel / production to use the web installer:
# a random string of 16+ characters you type into the wizard. Without it, /install is disabled
# in production (use `npm run setup` instead). Local `npm run dev` does not need it. Remove it
# (or leave it; the installer locks itself) after installing.
INSTALL_TOKEN=

# Login rate limiting uses the client IP. Set TRUSTED_PROXY=true ONLY when the app runs behind a reverse
# proxy (nginx, Caddy, load balancer) that OVERWRITES x-forwarded-for / x-real-ip with the real client
# address. Vercel is auto-detected. Leave unset when the app is exposed directly: forwarded headers are then
# ignored (clients control them) and only the per-email limit (20 failures / 15 min) applies.
TRUSTED_PROXY=

# IANA time zone for "today", report ranges and displayed dates. Default: Asia/Dhaka.
# APP_TIMEZONE=Asia/Dhaka

# Optional: folder of SQL migrations (default ./drizzle). Only change if you relocate it.
# SSERP_MIGRATIONS_DIR=

# Docker Compose only: password for the optional bundled Postgres (`docker compose --profile postgres up`).
# POSTGRES_PASSWORD=
