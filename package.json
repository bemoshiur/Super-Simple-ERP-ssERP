{
  "name": "sserp",
  "version": "0.1.0",
  "description": "Super Simple ERP - open-source ERP, Inventory and Billing with serial/IMEI tracking (Next.js + Neon)",
  "author": "bemoshiur",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:theme": "node scripts/theme-inventory.mjs",
    "format": "prettier --write './src/**/*.{ts,tsx,js,jsx}'",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "db:generate": "drizzle-kit generate",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:reset": "tsx scripts/admin-reset.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "icons": "tsx scripts/build-icons.ts",
    "test:e2e": "bash scripts/e2e.sh",
    "screenshots": "SCREENSHOTS=1 bash scripts/e2e.sh e2e/screenshots.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@iconify-json/lucide": "1.2.160",
    "@playwright/test": "1.65.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.6.2",
    "sass": "1.77.6",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@iconify/react": "^6.0.2",
    "@neondatabase/serverless": "^1.2.1",
    "@tanstack/react-table": "^8.21.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "jsbarcode": "3.12.3",
    "lodash": "^4.17.21",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.5",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.92.0",
    "usehooks-ts": "^3.1.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
