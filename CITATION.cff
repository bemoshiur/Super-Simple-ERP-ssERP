    family-names: "Rahman"
    alias: "bemoshiur"
version: "0.1.0"
license: MIT
repository-code: "https://github.com/bemoshiur/Super-Simple-ERP-ssERP"
url: "https://github.com/bemoshiur/Super-Simple-ERP-ssERP"
keywords:
